# OctoFit Tracker - Frontend Environment Variables Example
#
# Copy this file to .env.local and fill in your values
# for local development or Codespaces deployment.

# GitHub Codespaces - Replace with your actual Codespace name
# This enables API endpoints: https://${VITE_CODESPACE_NAME}-8000.app.github.dev/api/*
VITE_CODESPACE_NAME=
